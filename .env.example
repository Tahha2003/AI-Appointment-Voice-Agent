# Copy this file to .env and fill in your actual keys

# Groq API Key (FREE — get from https://console.groq.com)
GROQ_API_KEY=gsk_your-groq-key-here

# Vapi API Key (get from https://vapi.ai → Dashboard → API Keys)
VAPI_API_KEY=your-vapi-key-here

# Deployment URL
BACKEND_URL=https://ai-appointment-voice-agent.onrender.com

# Database path
# Local: patients.db
# Render: /tmp/patients.db
DB_PATH=patients.db
